#!/bin/bash

# make bash expand environment variables to paths on tab completion
shopt -s direxpand

export GOPATH="$HOME/.go"
export GOBIN="$GOPATH/bin"

export LOCAL_PATH=$HOME/.local
export PATH=$LOCAL_PATH/usr/bin:$LOCAL_PATH/bin:$PATH
export PATH=$HOME/.cargo/bin:$PATH
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    export PATH=$HOME/scoop/apps/gcc/current/bin:$PATH
else
    export PATH=/usr/local/go/bin:$GOBIN:$PATH
fi

### FZF ###
export FZF_DEFAULT_OPTS="                    \
    --bind '?:toggle-preview'                \
    --bind 'ctrl-j:down'                     \
    --bind 'ctrl-k:up'                       \
    --bind 'ctrl-e:preview-down'             \
    --bind 'ctrl-y:preview-up'               \
    --bind 'ctrl-u:preview-page-up'          \
    --bind 'ctrl-d:preview-page-down'        \
    --color=dark                             \
    --color=fg:-1,bg:-1,hl:#5fff87           \
    --color=fg+:-1,bg+:-1,hl+:#ffaf5f        \
    --color=info:#af87ff,prompt:#5fff87      \
    --color=pointer:#ff87d7,marker:#ff87d7   \
    --color=spinner:#ff87d7                  \
    --prompt='∼ ' --pointer='▶' --marker='✗' \
"

# fzf's command
export FZF_DEFAULT_COMMAND="    \
    fd --hidden                 \
       --follow                 \
       --exclude '.git'         \
       --exclude 'node_modules' \
"
# CTRL-T's command
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
# ALT-C's command
export FZF_ALT_C_COMMAND="$FZF_DEFAULT_COMMAND --type d"

# Shared previewer: bat for files, tree (fallback ls) for directories
_FZF_PREVIEW_CMD="if [[ -d {} ]]; then                                    \
                      tree -C {} 2> /dev/null || ls -AF --color=always {}; \
                  else                                                    \
                      bat -n --color=always --line-range :500 {}          \
                          2> /dev/null || head -500 {};                   \
                  fi"
export FZF_CTRL_T_OPTS="--preview '$_FZF_PREVIEW_CMD'"
export FZF_CTRL_R_OPTS="--preview 'echo {2..}' --preview-window down:3:wrap"
export FZF_ALT_C_OPTS="--preview '$_FZF_PREVIEW_CMD'"
export FZF_TMUX_OPTS='-p90%,60%'
